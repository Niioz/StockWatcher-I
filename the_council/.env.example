# The Council - Environment Variables
# Copy this file to '.env' and fill in your keys

# Your Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (Required for the AI brains - 100% Free)
GEMINI_API_KEY=your_gemini_api_key_here

# Serper API Key (Required for Google News search - 2500 free queries/month)
# Get one at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# CrewAI Tracing (optional — set to true to enable)
# CREWAI_TRACING_ENABLED=true
